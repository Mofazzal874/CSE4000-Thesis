<mxfile host="app.diagrams.net">
  <diagram name="fig_assign_mechanism" id="assignmech">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1170" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gt" value="Ground-truth box g&#10;(cx, cy, w, h)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cand" value="Candidate box b&#10;(cx, cy, w, h)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ciou" value="CIoU(g, b)&#10;(collapses for boxes &lt; 16 px)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#F5F5F5;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nwd" value="NWD similarity&#10;S = exp( −W₂(g,b) / C ),  C = 12.8&#10;(stays informative for tiny boxes)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#F5F5F5;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="blend" value="Blended overlap&#10;u = (1−γ)·CIoU + γ·S&#10;(the proposed change)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fontStyle=1;fillColor=#FFF2CC;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="230" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cls" value="Classification score s&#10;(from the head, unchanged)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="align" value="Alignment score&#10;t = s^p · u^q" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#F5F5F5;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="880" y="150" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="topk" value="Top-k selection&#10;→ positive training samples" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fillColor=#F5F5F5;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="880" y="330" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="gt" target="ciou"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="cand" target="ciou"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="gt" target="nwd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="cand" target="nwd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="1−γ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=13;" edge="1" parent="1" source="ciou" target="blend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="γ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=13;" edge="1" parent="1" source="nwd" target="blend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="blend" target="align"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="cls" target="align"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="align" target="topk"><mxGeometry relative="1" as="geometry" /></mxCell>
